class Analyzer:
    def __init__(self, path: str, func_name='main', scales=None, config_file=None, use_cache=True, lightweight=False):
        self.lightweight = lightweight
        # ...

    # ... (sca_scan, dast_scan, binary_analysis, check_cves same)

    def miri_check(self) -> Dict:
        if self.lightweight or self.language != 'rust':
            return {'skipped': 'MIRI for Rust only'}
        
        try:
            # Check if miri available
            subprocess.run(['cargo', '+nightly', 'miri', '--version'], capture_output=True, check=True)
        except:
            return {'error': 'MIRI not installed (need rustup component add miri --toolchain nightly)'}
        
        dir_path = os.path.dirname(self.path)
        cargo_toml = os.path.join(dir_path, 'Cargo.toml')
        is_project = os.path.exists(cargo_toml)
        
        env = os.environ.copy()
        env['MIRIFLAGS'] = self.config.get('miri_flags', '-Zmiri-many-seeds=0..5 -Zmiri-strict-provenance -Zmiri-symbolic-alignment-check')
        
        if is_project:
            # Run cargo miri test
            cmd = ['cargo', '+nightly', 'miri', 'test']
            try:
                result = subprocess.run(cmd, cwd=dir_path, env=env, capture_output=True, text=True, timeout=600)
            except subprocess.TimeoutExpired:
                return {'error': 'MIRI timed out'}
        else:
            # Single file: Compile to obj then miri run
            obj_path = self.path.replace('.rs', '.o')
            compile_cmd = ['rustc', '+nightly', '--emit=obj', self.path, '-o', obj_path, '-C', 'debuginfo=0']
            try:
                subprocess.run(compile_cmd, check=True)
            except subprocess.CalledProcessError as e:
                return {'error': f'Compilation failed: {e}'}
            
            cmd = ['miri', 'run', obj_path]
            try:
                result = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=600)
            except subprocess.TimeoutExpired:
                return {'error': 'MIRI timed out'}
            finally:
                if os.path.exists(obj_path):
                    os.remove(obj_path)
        
        ub_keywords = ["undefined behavior", "violates", "out of bounds", "data race", "aliasing violation", "uninitialized"]
        error_output = result.stderr.lower()
        ub_issues = [kw for kw in ub_keywords if kw in error_output]
        
        if result.returncode != 0:
            if any(ub_issues):
                return {'ub_detected': True, 'issues': ub_issues, 'details': result.stderr}
            elif "unsupported operation" in error_output:
                return {'status': 'unsupported', 'details': result.stderr}
            else:
                return {'error': 'Unknown MIRI failure', 'details': result.stderr}
        
        return {'ub_detected': False, 'details': 'No UB detected'}

    def dynamic_analysis(self, *args) -> Dict:
        result = super().dynamic_analysis(*args) if self.language == 'python' else {}
        if self.language == 'rust' and not self.lightweight:
            miri_result = self.miri_check()
            result['miri'] = miri_result
            if 'ub_detected' in miri_result and miri_result['ub_detected']:
                result['ub_issues'] = miri_result.get('issues', [])
        return result

