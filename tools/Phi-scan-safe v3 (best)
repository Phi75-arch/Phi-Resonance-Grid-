def print_findings_section(findings, section_type, title, icon, limit=5):
    """Print a section of findings"""
    items = findings[section_type]
    if not items:
        return
        
    print(f"\n{icon} {title} ({len(items)} found):")
    
    for item in items[:limit]:
        if 'line' in item:
            severity_icon = ''
            if 'severity' in item:
                severity_map = {'high': '🔴', 'medium': '🟡', 'low': '⚪'}
                severity_icon = severity_map.get(item['severity'], '') + ' '
            
            print(f"  {severity_icon}Line {item['line']}: {item['type']}")
            print(f"     {item['message']}")
            if 'suggestion' in item:
                print(f"     💡 {item['suggestion']}")
        else:
            print(f"  {item['message']}")
    
    if len(items) > limit:
        print(f"  ... and {len(items) - limit} more")

