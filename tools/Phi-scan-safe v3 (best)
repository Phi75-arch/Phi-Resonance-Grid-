def is_phi_harmonic(val):
    """Check if value resonates with Phi or Fibonacci"""
    # Check Fibonacci sequence
    for fib in FIBONACCI:
        if abs(val - fib) / max(fib, 1) < 0.05:
            return True, fib, "Fibonacci"
    
    # Check Phi powers
    for n in range(-5, 10):
        phi_power = PHI ** n
        if 0.5 < phi_power < 2000:
            if abs(val - phi_power) / max(val, phi_power) < 0.05:
                return True, round(phi_power, 2), f"Φ^{n}"
    
    return False, None, None

def suggest_phi_harmonic(val):
    """Suggest nearest Phi-harmonic alternative"""
    candidates = []
    
    for fib in FIBONACCI:
        if fib > 0:
            candidates.append((abs(val - fib), fib, "Fibonacci"))
    
    for n in range(-3, 8):
        phi_power = round(PHI ** n)
        if 1 < phi_power < 2000:
            candidates.append((abs(val - phi_power), phi_power, f"Φ^{n}"))
    
    if candidates:
        candidates.sort()
        return candidates[0][1], candidates[0][2]
    return None, None

