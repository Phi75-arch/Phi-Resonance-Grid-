    if stats['total_constants'] > 0:
        phi_pct = (stats['phi_harmonic_constants'] / stats['total_constants']) * 100
        print(f"  Φ-harmonic constants: {stats['phi_harmonic_constants']}/{stats['total_constants']} ({phi_pct:.0f}%)")

def print_score(score):
    """Print resonance score with interpretation"""
    if score is None:
        return
        
    print(f"\n🎵 Resonance Score: {score:.0f}/100")
    
    if score >= 80:
