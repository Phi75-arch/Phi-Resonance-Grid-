def load_and_parse(filepath):
    """Load file and parse into AST"""
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            content = f.read()
        tree = ast.parse(content)
        return tree, None
    except FileNotFoundError:
        return None, "File not found"
    except SyntaxError as e:
        return None, f"Syntax error: {e}"
    except Exception as e:
        return None, f"Error reading file: {e}"

def analyze_file(filepath):
    """Main analysis function - now orchestrates focused analyzers"""
    findings = {
        'dissonance': [],
        'resonance': [],
        'neutral': []
    }
    stats = {
        'functions': 0,
        'avg_complexity': 0,
        'phi_harmonic_constants': 0,
        'total_constants': 0
    }
    
    # Load and parse
    tree, error = load_and_parse(filepath)
    if error:
        findings['dissonance'].append({'message': error})
        return findings, stats
    
    # Run focused analyzers
    analyze_parameters(tree, findings)
    analyze_complexity_patterns(tree, findings, stats)
    analyze_loop_patterns(tree, findings)
    analyze_constants(tree, findings, stats)
    
    return findings, stats

