def analyze_parameters(tree, findings):
    """Analyze function parameter counts"""
    phi_limit = round(7 / PHI)  # ≈ 4
    
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef):
            continue
            
        param_count = len(node.args.args)
        
        if param_count > 5:
            findings['dissonance'].append({
                'line': node.lineno,
                'type': 'Parameter Overload',
                'message': f"Function '{node.name}' has {param_count} parameters",
                'suggestion': f"Φ-harmonic limit: {phi_limit}-5. Consider context object",
                'severity': 'medium'
            })
        elif param_count <= phi_limit:
            findings['resonance'].append({
                'line': node.lineno,
                'type': 'Clean Interface',
                'message': f"Function '{node.name}' has {param_count} parameters (Φ-harmonic ✓)"
            })

def analyze_complexity_patterns(tree, findings, stats):
    """Analyze cyclomatic complexity and recursion"""
    phi_complexity_limit = round(10 / PHI)  # ≈ 6
    complexities = []
    
    for node in ast.walk(tree):
        if not isinstance(node, ast.FunctionDef):
            continue
            
        stats['functions'] += 1
        complexity = calculate_complexity(node)
        complexities.append(complexity)
        
        # Check complexity
        if complexity > phi_complexity_limit:
            findings['dissonance'].append({
                'line': node.lineno,
                'type': 'Cognitive Overload',
                'message': f"Function '{node.name}' complexity: {complexity}",
                'suggestion': f"Φ-limit: {phi_complexity_limit}. Extract helpers or use early returns",
                'severity': 'high'
            })
        elif complexity <= 3:
            findings['resonance'].append({
                'line': node.lineno,
                'type': 'Flow State',
                'message': f"Function '{node.name}' complexity: {complexity} (low cognitive load ✓)"
            })
        
        # Check recursion
        if check_recursion(node, node.name):
            findings['resonance'].append({
                'line': node.lineno,
                'type': 'Fractal Pattern',
                'message': f"Function '{node.name}' uses recursion (self-similar, Φ-spiral ✓)"
            })
    
    if complexities:
        stats['avg_complexity'] = sum(complexities) / len(complexities)

def analyze_loop_patterns(tree, findings):
    """Analyze loop nesting depth"""
    for node in ast.walk(tree):
        if not isinstance(node, (ast.For, ast.While)):
            continue
            
        depth = count_loop_depth(node, 1)
        if depth > 2:
            findings['dissonance'].append({
                'line': node.lineno,
                'type': 'Forced Iteration',
                'message': f"Loop nesting depth: {depth}",
                'suggestion': "Wu Wei: Consider map/filter/reduce or recursion",
                'severity': 'medium'
            })

def is_analyzable_constant(val):
    """Guard: Check if constant should be analyzed"""
    if val in (0, 1, -1, 2, 10, 100, 1000):
        return False
    if val < 0:
        return False
    if not (2 <= val <= 1000):
        return False
    return True

def analyze_constants(tree, findings, stats):
    """Analyze magic numbers for Φ-harmonic patterns"""
    for node in ast.walk(tree):
        if not isinstance(node, ast.Constant):
            continue
        if not isinstance(node.value, (int, float)):
            continue
            
        val = node.value
        
        # Early return guards
        if not is_analyzable_constant(val):
            continue
        
        stats['total_constants'] += 1
        is_harmonic, match_val, match_type = is_phi_harmonic(val)
        
        if is_harmonic:
            stats['phi_harmonic_constants'] += 1
            findings['resonance'].append({
                'line': node.lineno,
                'type': 'Natural Constant',
                'message': f"Value {val} resonates with {match_type}: {match_val} ✓"
            })
        else:
            suggestion, basis = suggest_phi_harmonic(val)
            if suggestion and abs(val - suggestion) / val > 0.1:
                findings['neutral'].append({
                    'line': node.lineno,
                    'type': 'Arbitrary Constant',
                    'message': f"Magic number: {val}",
                    'suggestion': f"Φ-harmonic alternative: {suggestion} ({basis})",
                    'severity': 'low'
                })

