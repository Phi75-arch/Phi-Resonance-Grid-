class UniversalVisitor:
    # ... (same, but add fix methods)

    def apply_fixes(self, code: str, language: str) -> str:
        if language == 'python':
            return self._fix_python(code)
        elif language == 'rust':
            return self._fix_rust(code)
        return code  # No fix for others

    def _fix_python(self, code: str) -> str:
        try:
            import rope.base.project
            project = rope.base.project.Project('.')
            resource = project.get_resource(self.path) if hasattr(self, 'path') else None
            # Simple refactors: Remove unused
            for var in self.unused_vars:
                # Use rope to remove assignments (stub; expand)
                pass
            # Add type hints (heuristic)
            tree = ast.parse(code)
            # Traverse and add :Any for args, ->None for returns
            class TypeAdder(ast.NodeTransformer):
                def visit_FunctionDef(self, node):
                    for arg in node.args.args:
                        if not arg.annotation:
                            arg.annotation = ast.Name(id='Any', ctx=ast.Load())
                    if not node.returns:
                        node.returns = ast.Name(id='None', ctx=ast.Load())
                    return self.generic_visit(node)
            new_tree = TypeAdder().visit(tree)
            ast.fix_missing_locations(new_tree)
            fixed_code = ast.unparse(new_tree)
            
            # Patch vulns: Replace exec/eval with safer
            fixed_code = re.sub(r'exec\(', '# FIXED: exec(', fixed_code)
            fixed_code = re.sub(r'eval\(', '# FIXED: eval(', fixed_code)
            
            # Optimize hotspots (e.g., add @lru_cache to funcs with high CC)
            # Stub: Identify and add
            return fixed_code
        except:
            return code

    def _fix_rust(self, code: str) -> str:
        try:
            # Run rustfmt
            subprocess.run(['rustfmt', self.path], check=True)
            # Run clippy --fix if avail
            subprocess.run(['cargo', 'clippy', '--fix', '--allow-staged', '--allow-dirty'], cwd=os.path.dirname(self.path))
            # Remove unused: Rely on clippy
            # Patch unsafe: Comment out unsafe blocks (simple)
            lines = code.splitlines()
            in_unsafe = False
            for i, line in enumerate(lines):
                if 'unsafe {' in line:
                    in_unsafe = True
                    lines[i] = '// FIXED: ' + line
                elif in_unsafe and '}' in line:
                    in_unsafe = False
                    lines[i] = '// ' + line
            return '\n'.join(lines)
        except:
            return code

class Analyzer:
    # ... (init add self.autofix = False)

    def rectify_code(self):
        if not self.autofix:
            return
        backup = self.path + '.bak'
        shutil.copy(self.path, backup)
        with open(self.path, 'r') as f:
            code = f.read()
        visitor = UniversalVisitor(...)  # From static_analysis
        # Run visitor to get issues
        fixed_code = visitor.apply_fixes(code, self.language)
        with open(self.path, 'w') as f:
            f.write(fixed_code)
        self.audit_log('Applied autofix')

