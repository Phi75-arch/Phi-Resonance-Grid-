class UniversalVisitor:
    # ... (enhanced with Java fixes)

    def apply_fixes(self, code: str, language: str, dry_run: bool = False) -> Tuple[str, List[str]]:
        fixes = []
        if language == 'python':
            fixed_code, py_fixes = self._fix_python_robust(code)
            fixes.extend(py_fixes)
        elif language == 'rust':
            fixed_code, rs_fixes = self._fix_rust_robust(code)
            fixes.extend(rs_fixes)
        elif language == 'java':
            fixed_code, java_fixes = self._fix_java_robust(code)
            fixes.extend(java_fixes)
        else:
            fixed_code = code

        # Prioritize by severity (e.g., vulns first in fixes list)
        fixes = sorted(fixes, key=lambda f: 'vuln' in f.lower(), reverse=True)

        if dry_run:
            diff = '\n'.join(difflib.unified_diff(code.splitlines(), fixed_code.splitlines(), lineterm=''))
            print(f"Dry-run diff for {language}:\n{diff}")
            return code, fixes
        return fixed_code, fixes

    def _fix_java_robust(self, code: str) -> Tuple[str, List[str]]:
        fixes = []
        # Format with google-java-format (assume jar in PATH or download)
        try:
            jar_path = 'google-java-format-1.15.0-all-deps.jar'  # Assume downloaded
            subprocess.run(['java', '-jar', jar_path, '--replace', self.path], check=True)
            fixes.append('Applied google-java-format')
        except:
            pass

        # AST fixes with jAST
        try:
            tree = jast.parse(code)

            # Collect used identifiers for unused removal
            used = set()
            class UsedCollector(jast.JNodeVisitor):
                def visit_identifier(self, node):
                    used.add(node.value)  # Approx

            UsedCollector().visit(tree)

            # Transformer: Remove unused imports
            class ImportRemover(jast.JNodeTransformer):
                def visit_import_declaration(self, node):
                    name = node.qualifier.value if node.qualifier else node.name.value
                    if name not in used:
                        return None  # Remove
                    return node

            tree = ImportRemover().visit(tree)
            fixes.append('Removed unused imports')

            # Patch vulns: Replace Runtime.getRuntime().exec
            class VulnPatcher(jast.JNodeTransformer):
                def visit_method_invocation(self, node):
                    if 'exec' in str(node) and 'Runtime' in str(node):
                        # Comment out or replace
                        return jast.comment('FIXED: Vulnerable exec', node)
                    return node

            tree = VulnPatcher().visit(tree)
            fixes.append('Patched exec vulns')

            # Fix broad catch: Add specific exception
            class CatchFixer(jast.JNodeTransformer):
                def visit_catch_clause(self, node):
                    if node.parameter.types[0].value == 'Exception':
                        node.parameter.types[0].value = 'SpecificException'  # Heuristic
                    return node

            tree = CatchFixer().visit(tree)
            fixes.append('Specified catch exceptions')

            fixed_code = jast.unparse(tree)
        except Exception as e:
            fixed_code = code
            fixes.append(f'jAST error: {e}')

        return fixed_code, fixes

    # _fix_python_robust, _fix_rust_robust same as v16

class Analyzer:
    # ... (rectify_code updated to use dry_run)

    def rectify_code(self):
        if not self.autofix:
            return []
        backup = self.path + '.bak'
        shutil.copy(self.path, backup)
        with open(self.path, 'r') as f:
            code = f.read()
        visitor = UniversalVisitor(...)  # From analysis
        fixed_code, fixes = visitor.apply_fixes(code, self.language, dry_run=self.dry_run)
        if not self.dry_run:
            with open(self.path, 'w') as f:
                f.write(fixed_code)
            self.audit_log(f'Applied {len(fixes)} fixes for {self.language}')
        return fixes

