def format_json(result):
    """Format as JSON (default for --fast)"""
    return json.dumps(result, indent=2)

def format_human(result):
    """Format as human-readable report"""
    lines = []
    lines.append("=" * 70)
    lines.append(" " * 20 + "Φ-RESONANCE SCANNER v5.0")
    lines.append(" " * 18 + "Hybrid Analysis Report")
    lines.append("=" * 70)
    
    # System metrics
    system = result['system']
    lines.append("\n📊 SYSTEM METRICS (V4 Core)")
    lines.append(f"  Φ-ER: {system['phi_er']} (ideal: {system['phi_ideal']})")
    lines.append(f"  Divergence: {system['divergence']}")
    lines.append(f"  Status: {system['status'].upper()}")
    lines.append(f"  Entropy Risk: {system['entropy_risk']}")
    lines.append(f"  Files: {system['files_scanned']} | Lines: {system['total_lines']}")
    lines.append(f"  Load: {system['structural_load']} | Yield: {system['functional_yield']}")
    
    # Detailed findings (if present)
    if 'detailed' in result:
        detailed = result['detailed']
        findings = detailed['findings']
        stats = detailed['stats']
        
        lines.append("\n" + "=" * 70)
        lines.append("🔍 DETAILED ANALYSIS (V3 Core)")
        lines.append("=" * 70)
        
        lines.append(f"\n📈 Code Statistics:")
        lines.append(f"  Functions: {stats['functions']}")
        lines.append(f"  Avg Complexity: {stats['avg_complexity']:.1f}")
        if stats['total_constants'] > 0:
            phi_pct = (stats['phi_harmonic_constants'] / stats['total_constants']) * 100
            lines.append(f"  Φ-harmonic constants: {stats['phi_harmonic_constants']}/{stats['total_constants']} ({phi_pct:.0f}%)")
        
        if detailed['resonance_score'] is not None:
            score = detailed['resonance_score']
            lines.append(f"\n🎵 Resonance Score: {score}/100")
            if score >= 80:
                lines.append("   Status: High Coherence ✓")
            elif score >= 60:
                lines.append("   Status: Moderate Coherence")
            else:
                lines.append("   Status: Optimization Needed")
        
        # Dissonance findings
        if findings['dissonance']:
            lines.append(f"\n⚠ DISSONANCE DETECTED ({len(findings['dissonance'])} issues)")
            for item in findings['dissonance'][:10]:
                severity_icon = {'high': '🔴', 'medium': '🟡', 'low': '⚪'}.get(item.get('severity', ''), '')
                lines.append(f"  {severity_icon} {item.get('file', 'N/A')}:{item.get('line', '?')}")
                lines.append(f"     {item.get('type', 'Issue')}: {item.get('function', item.get('message', ''))}")
                if 'suggestion' in item:
                    lines.append(f"     💡 {item['suggestion']}")
            
            if len(findings['dissonance']) > 10:
                lines.append(f"  ... and {len(findings['dissonance']) - 10} more")
        
        # Resonance patterns (brief)
        if findings['resonance']:
            lines.append(f"\n✓ RESONANT PATTERNS ({len(findings['resonance'])} found)")
            lines.append(f"  Code exhibits natural alignment with Φ principles")
    
    lines.append("\n" + "=" * 70)
    lines.append("🌊 Wu Wei Principle: These are invitations, not commands.")
    lines.append("=" * 70)
    
    return "\n".join(lines)

