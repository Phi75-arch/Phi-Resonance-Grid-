class SystemAnalyzer(ast.NodeVisitor):
    """Fast system-wide analyzer (V4 approach)"""
    
    def __init__(self):
        self.metrics = SystemMetrics()
    
    def visit_FunctionDef(self, node):
        self.metrics.structural_load += self._complexity(node)
        self.metrics.functional_yield += 1
        self.generic_visit(node)
    
    def _complexity(self, node):
        """Calculate cyclomatic complexity"""
        score = 1
        for n in ast.walk(node):
            if isinstance(n, (ast.If, ast.For, ast.While, ast.ExceptHandler,
                            ast.With, ast.Assert, ast.And, ast.Or)):
                score += 1
        return score
    
    def scan_path(self, path: Path) -> SystemMetrics:
        """Scan entire directory tree"""
        target = Path(path)
        
        if target.is_file():
            self._scan_file(target)
        else:
            for file in target.rglob("*.py"):
                self._scan_file(file)
        
        return self.metrics
    
    def _scan_file(self, filepath: Path):
        """Scan single file"""
        try:
            content = filepath.read_text(encoding='utf-8')
            self.metrics.total_files += 1
            self.metrics.total_lines += len(content.splitlines())
            tree = ast.parse(content)
            self.visit(tree)
        except Exception:
            pass  # Silent fail for unparseable files

# ============================================================================
# V3 CORE: DETAILED ANALYSIS ENGINE
# ============================================================================

class DetailedAnalyzer:
    """Granular line-by-line analyzer (V3 approach)"""
    
    def __init__(self):
        self.findings = DetailedFindings()
        self.stats = {
            'functions': 0,
            'avg_complexity': 0,
            'phi_harmonic_constants': 0,
            'total_constants': 0
        }
    
    def analyze_file(self, filepath: Path) -> Tuple[DetailedFindings, Dict]:
        """Analyze single file in detail"""
        try:
            content = filepath.read_text(encoding='utf-8')
            tree = ast.parse(content)
            
            self._analyze_parameters(tree, str(filepath))
            self._analyze_complexity(tree, str(filepath))
            self._analyze_loops(tree, str(filepath))
            self._analyze_constants(tree, str(filepath))
            
            return self.findings, self.stats
            
        except Exception as e:
            self.findings.dissonance.append({
                'file': str(filepath),
                'message': f"Parse error: {e}"
            })
            return self.findings, self.stats
    
    def _analyze_parameters(self, tree, filepath):
        """Check function parameter counts"""
        phi_limit = round(7 / PHI)  # ≈ 4
        
        for node in ast.walk(tree):
            if not isinstance(node, ast.FunctionDef):
                continue
            
            param_count = len(node.args.args)
            
            if param_count > 5:
                self.findings.dissonance.append({
                    'file': filepath,
                    'line': node.lineno,
                    'type': 'Parameter Overload',
                    'function': node.name,
                    'count': param_count,
                    'suggestion': f"Φ-limit: {phi_limit}. Consider context object",
                    'severity': 'medium'
                })
            elif param_count <= phi_limit:
                self.findings.resonance.append({
                    'file': filepath,
                    'line': node.lineno,
                    'type': 'Clean Interface',
                    'function': node.name,
                    'count': param_count
                })
    
    def _analyze_complexity(self, tree, filepath):
        """Analyze cyclomatic complexity"""
        phi_limit = round(10 / PHI)  # ≈ 6
        complexities = []
        
        for node in ast.walk(tree):
            if not isinstance(node, ast.FunctionDef):
                continue
            
            self.stats['functions'] += 1
            complexity = self._calculate_complexity(node)
            complexities.append(complexity)
            
            if complexity > phi_limit:
                self.findings.dissonance.append({
                    'file': filepath,
                    'line': node.lineno,
                    'type': 'Cognitive Overload',
                    'function': node.name,
                    'complexity': complexity,
                    'suggestion': f"Φ-limit: {phi_limit}. Extract helpers",
                    'severity': 'high'
                })
            elif complexity <= 3:
                self.findings.resonance.append({
                    'file': filepath,
                    'line': node.lineno,
                    'type': 'Flow State',
                    'function': node.name,
                    'complexity': complexity
                })
        
        if complexities:
            self.stats['avg_complexity'] = sum(complexities) / len(complexities)
    
    def _calculate_complexity(self, node):
        """Calculate cyclomatic complexity"""
        complexity = 1
        for child in ast.walk(node):
            if isinstance(child, (ast.If, ast.For, ast.While, ast.ExceptHandler,
                                ast.With, ast.Assert)):
                complexity += 1
            elif isinstance(child, ast.BoolOp):
                complexity += len(child.values) - 1
        return complexity
    
    def _analyze_loops(self, tree, filepath):
        """Analyze loop nesting depth"""
        for node in ast.walk(tree):
            if not isinstance(node, (ast.For, ast.While)):
                continue
            
            depth = self._count_loop_depth(node, 1)
            if depth > 2:
                self.findings.dissonance.append({
                    'file': filepath,
                    'line': node.lineno,
                    'type': 'Forced Iteration',
                    'depth': depth,
                    'suggestion': "Consider map/filter/reduce or recursion",
                    'severity': 'medium'
                })
    
    def _count_loop_depth(self, node, current_depth=0):
        """Count maximum loop nesting depth"""
        max_depth = current_depth
        for child in ast.iter_child_nodes(node):
            if isinstance(child, (ast.For, ast.While)):
                child_depth = self._count_loop_depth(child, current_depth + 1)
                max_depth = max(max_depth, child_depth)
            else:
                child_depth = self._count_loop_depth(child, current_depth)
                max_depth = max(max_depth, child_depth)
        return max_depth
    
    def _analyze_constants(self, tree, filepath):
        """Analyze magic numbers for Φ-harmonic patterns"""
        for node in ast.walk(tree):
            if not isinstance(node, ast.Constant):
                continue
            if not isinstance(node.value, (int, float)):
                continue
            
            val = node.value
            
            # Skip common values
            if val in (0, 1, -1, 2, 10, 100, 1000) or val < 0:
                continue
            if not (2 <= val <= 1000):
                continue
            
            self.stats['total_constants'] += 1
            is_harmonic, match_val, match_type = self._is_phi_harmonic(val)
            
            if is_harmonic:
                self.stats['phi_harmonic_constants'] += 1
                self.findings.resonance.append({
                    'file': filepath,
                    'line': node.lineno,
                    'type': 'Natural Constant',
                    'value': val,
                    'matches': f"{match_type}: {match_val}"
                })
    
    def _is_phi_harmonic(self, val):
        """Check if value resonates with Phi or Fibonacci"""
        # Check Fibonacci
        for fib in FIBONACCI:
            if abs(val - fib) / max(fib, 1) < 0.05:
                return True, fib, "Fibonacci"
        
        # Check Phi powers
        for n in range(-5, 10):
            phi_power = PHI ** n
            if 0.5 < phi_power < 2000:
                if abs(val - phi_power) / max(val, phi_power) < 0.05:
                    return True, round(phi_power, 2), f"Φ^{n}"
        
        return False, None, None

