class PhiScanner:
    """Unified V5 scanner with multiple modes"""
    
    def __init__(self, mode='fast'):
        self.mode = mode
        self.system_analyzer = SystemAnalyzer()
        self.detailed_analyzer = DetailedAnalyzer() if mode != 'fast' else None
    
    def scan(self, path: str):
        """Main scan entry point"""
        target = Path(path)
        
        if not target.exists():
            return {'error': f"Path not found: {path}"}
        
        # Always run system scan (fast)
        system_metrics = self.system_analyzer.scan_path(target)
        
        result = {
            'system': self._format_system_metrics(system_metrics),
            'mode': self.mode
        }
        
        # Optionally run detailed scan
        if self.mode in ('detailed', 'both'):
            if target.is_file():
                findings, stats = self.detailed_analyzer.analyze_file(target)
            else:
                findings, stats = self._scan_directory_detailed(target)
            
            result['detailed'] = {
                'findings': asdict(findings),
                'stats': stats,
                'resonance_score': self._calculate_resonance_score(findings, stats)
            }
        
        return result
    
    def _scan_directory_detailed(self, path: Path):
        """Scan directory with detailed analysis"""
        combined_findings = DetailedFindings()
        combined_stats = {
            'functions': 0,
            'avg_complexity': 0,
            'phi_harmonic_constants': 0,
            'total_constants': 0
        }
        
        for file in path.rglob("*.py"):
            analyzer = DetailedAnalyzer()
            findings, stats = analyzer.analyze_file(file)
            
            # Merge findings
            combined_findings.dissonance.extend(findings.dissonance)
            combined_findings.resonance.extend(findings.resonance)
            combined_findings.neutral.extend(findings.neutral)
            
            # Aggregate stats
            combined_stats['functions'] += stats['functions']
            combined_stats['phi_harmonic_constants'] += stats['phi_harmonic_constants']
            combined_stats['total_constants'] += stats['total_constants']
        
        # Calculate average complexity
        if combined_stats['functions'] > 0:
            total_complexity = sum(
                f.get('complexity', 0) 
                for f in combined_findings.dissonance + combined_findings.resonance
                if 'complexity' in f
            )
            combined_stats['avg_complexity'] = total_complexity / combined_stats['functions']
        
        return combined_findings, combined_stats
    
    def _format_system_metrics(self, metrics: SystemMetrics):
        """Format system metrics for output"""
        return {
            'phi_er': round(metrics.phi_er, 3),
            'phi_ideal': round(PHI, 3),
            'divergence': round(metrics.divergence, 3),
            'status': metrics.status,
            'entropy_risk': 'low' if metrics.divergence <= EPSILON else 'elevated',
            'structural_load': metrics.structural_load,
            'functional_yield': metrics.functional_yield,
            'files_scanned': metrics.total_files,
            'total_lines': metrics.total_lines
        }
    
    def _calculate_resonance_score(self, findings, stats):
        """Calculate V3-style resonance score"""
        if stats['functions'] == 0:
            return None
        
        score = 50
        
        # Penalties for dissonance
        high = len([f for f in findings.dissonance if f.get('severity') == 'high'])
        medium = len([f for f in findings.dissonance if f.get('severity') == 'medium'])
        low = len([f for f in findings.dissonance if f.get('severity') == 'low'])
        
        score -= high * 10
        score -= medium * 5
        score -= low * 2
        
        # Bonuses for resonance
        score += min(len(findings.resonance) * 2, 30)
        
        if stats['total_constants'] > 0:
            phi_ratio = stats['phi_harmonic_constants'] / stats['total_constants']
            score += phi_ratio * 20
        
        return max(0, min(100, round(score)))

