// ═══════════════════════════════════════
// TAB SWITCHING
// ═══════════════════════════════════════
function switchTab(name) {
  document.querySelectorAll('.tab').forEach((t,i) => {
    const names = ['voice','peers','vpn'];
    t.classList.toggle('active', names[i] === name);
  });
  document.querySelectorAll('.tab-content').forEach(c => {
    c.classList.toggle('active', c.id === 'tab-' + name);
  });
}

// ═══════════════════════════════════════
// PHI KEY ENGINE
// ═══════════════════════════════════════
const PHI = 1.6180339887498948482;
const SQRT3 = 1.7320508075688772;
const TAU = Math.PI * 2;

class PhiKeyEngine {
  constructor(seed) {
    this.seed = seed;
    this.epoch = 0;
    this.theta = this.seedToTheta(seed);
    this.r = 1.0;
    this.sessionId = Date.now().toString(16).toUpperCase() + Math.random().toString(16).slice(2,8).toUpperCase();
    this.history = [];
  }
  seedToTheta(s) {
    let h = 0x811c9dc5;
    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
    return (h / 0xffffffff) * TAU * PHI % TAU;
  }
  advance() {
    this.epoch++;
    this.theta = (this.theta + PHI) % TAU;
    this.r = this.r / PHI;
    if (this.r < 0.001) this.r = 1.0;
    const k = this.currentKey();
    this.history.unshift({ epoch: this.epoch, key: k, theta: this.theta.toFixed(6) });
    if (this.history.length > 8) this.history.pop();
    return k;
  }
  currentKey() {
    const x = this.r * Math.cos(this.theta);
    const y = this.r * Math.sin(this.theta);
    return this.hash(`${this.seed}:${this.epoch}:${x.toFixed(14)}:${y.toFixed(14)}:${SQRT3}:${PHI}`);
  }
  hash(s) {
    let h1 = 0xdeadbeef ^ s.length, h2 = 0x41c6ce57 ^ s.length;
    for (let i = 0; i < s.length; i++) {
      const c = s.charCodeAt(i);
      h1 = Math.imul(h1 ^ c, 0x9e3779b9); h2 = Math.imul(h2 ^ c, 0x5f4a7c15);
      h1 ^= h2 >>> 13; h2 ^= h1 >>> 11;
    }
    h1 = (Math.imul(h1 ^ h2 >>> 16, 0x85ebca6b)) >>> 0;
    h2 = (Math.imul(h2 ^ h1 >>> 13, 0xc2b2ae35)) >>> 0;
    return (h1 >>> 0).toString(16).padStart(8,'0').toUpperCase() +
           (h2 >>> 0).toString(16).padStart(8,'0').toUpperCase();
  }
  getEntropy() { return Math.floor(64 + this.epoch * Math.log2(PHI + 1)); }
}

