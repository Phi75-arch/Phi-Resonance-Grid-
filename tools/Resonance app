function updateKeyDisplay() {
  if (!engine) return;
  $('angleVal').textContent = `${(engine.theta*180/Math.PI).toFixed(4)}° (${engine.theta.toFixed(8)} rad)`;
  $('epochVal').textContent = `EPOCH-${engine.epoch} · φ-advance ${(engine.epoch*PHI%TAU).toFixed(6)}`;
