<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resonance — Encrypted P2P Voice</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Cinzel:wght@300;400&family=Crimson+Pro:ital,wght@0,300;1,300&display=swap');

:root {
  --bg: #060708;
  --bg2: #0c0e12;
  --panel: #0f1118;
  --border: #1e2230;
  --gold: #c8a020;
  --gold-dim: #5a4808;
  --gold-glow: #e8c840;
  --blue: #2a7aaa;
  --blue-bright: #4aaad4;
  --green: #2a8a4a;
  --green-bright: #4adc7a;
  --red: #aa2a2a;
  --red-bright: #dd4444;
  --purple: #7a4aaa;
  --purple-bright: #aa7add;
  --text: #c8c0a8;
  --text-dim: #4a4838;
  --mono: 'Share Tech Mono', monospace;
  --serif: 'Cinzel', serif;
  --body: 'Crimson Pro', serif;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1.5rem 1rem 4rem;
  overflow-x: hidden;
}

body::before {
  content:'';
  position:fixed; inset:0;
  background: repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.07) 2px,rgba(0,0,0,0.07) 4px);
  pointer-events:none; z-index:100;
}

/* TABS */
.tabs {
  display: flex;
  gap: 0;
  margin-bottom: 1.2rem;
  border: 1px solid var(--border);
  border-radius: 2px;
  overflow: hidden;
  width: 100%;
  max-width: 720px;
}

.tab {
  flex: 1;
  padding: 0.7rem 1rem;
  background: var(--bg2);
  border: none;
  border-right: 1px solid var(--border);
  color: var(--text-dim);
  font-family: var(--mono);
  font-size: 0.58rem;
  letter-spacing: 0.2em;
  cursor: pointer;
  transition: all 0.2s;
  text-transform: uppercase;
}
.tab:last-child { border-right: none; }
.tab:hover { color: var(--text); background: var(--panel); }
.tab.active { background: var(--panel); color: var(--gold); border-bottom: 1px solid var(--gold-dim); }

.tab-content { display: none; width: 100%; max-width: 720px; }
.tab-content.active { display: flex; flex-direction: column; gap: 0.9rem; }

/* HEADER */
header { text-align:center; margin-bottom:1.5rem; animation: fadeIn 1s ease; }
.logo { font-family:var(--serif); font-weight:300; font-size:clamp(1.3rem,4vw,1.9rem); letter-spacing:0.5em; color:var(--gold); text-shadow:0 0 30px rgba(200,160,32,0.3); margin-bottom:0.2rem; }
.tagline { font-family:var(--mono); font-size:0.56rem; letter-spacing:0.2em; color:var(--text-dim); }

/* PANELS */
.panel { background:var(--panel); border:1px solid var(--border); border-radius:2px; padding:1.2rem 1.4rem; position:relative; }
.panel::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,var(--gold-dim),transparent); opacity:0.5; }
.panel-label { font-family:var(--mono); font-size:0.56rem; letter-spacing:0.28em; color:var(--text-dim); margin-bottom:0.8rem; text-transform:uppercase; }

/* FORMS */
.row { display:flex; gap:0.6rem; align-items:stretch; }
.input-field {
  flex:1; background:var(--bg2); border:1px solid var(--border);
  color:var(--gold); font-family:var(--mono); font-size:0.9rem;
  letter-spacing:0.12em; padding:0.55rem 0.8rem; outline:none; border-radius:1px;
  transition:border-color 0.3s;
}
.input-field:focus { border-color:var(--gold-dim); box-shadow:0 0 10px rgba(200,160,32,0.08); }
.input-field::placeholder { color:var(--text-dim); font-size:0.65rem; }

.btn {
  background:transparent; border:1px solid var(--border);
  color:var(--text); font-family:var(--mono); font-size:0.6rem;
  letter-spacing:0.18em; padding:0.55rem 0.9rem; cursor:pointer;
  border-radius:1px; transition:all 0.2s; text-transform:uppercase; white-space:nowrap;
}
.btn:hover { border-color:var(--gold-dim); color:var(--gold); background:rgba(200,160,32,0.04); }
.btn.blue { border-color:var(--blue); color:var(--blue-bright); }
.btn.blue:hover { background:rgba(42,122,170,0.08); }
.btn.green { border-color:var(--green); color:var(--green-bright); }
.btn.green:hover { background:rgba(42,138,74,0.08); }
.btn.red { border-color:var(--red); color:var(--red-bright); }
.btn.red:hover { background:rgba(170,42,42,0.08); }
.btn.purple { border-color:var(--purple); color:var(--purple-bright); }
.btn.purple:hover { background:rgba(122,74,170,0.08); }

/* STATUS */
.status-bar { display:flex; align-items:center; gap:0.8rem; padding:0.5rem 0.8rem; background:var(--bg); border:1px solid var(--border); border-radius:1px; }
.dot { width:7px; height:7px; border-radius:50%; background:var(--text-dim); flex-shrink:0; transition:all 0.3s; }
.dot.connected { background:var(--green-bright); box-shadow:0 0 8px var(--green-bright); animation:pulse-dot 2s infinite; }
.dot.connecting { background:var(--gold); animation:blink 0.6s infinite; }
.dot.transmitting { background:var(--gold-glow); box-shadow:0 0 12px var(--gold-glow); animation:pulse-gold 0.4s infinite; }
.dot.vpn { background:var(--purple-bright); box-shadow:0 0 8px var(--purple-bright); animation:pulse-dot 2s infinite; }
.status-text { font-family:var(--mono); font-size:0.6rem; letter-spacing:0.12em; color:var(--text-dim); flex:1; }
.status-badge { font-family:var(--mono); font-size:0.55rem; color:var(--text-dim); }

/* VISUALIZER */
.vis-wrap { display:flex; gap:1.2rem; align-items:flex-start; }
#spiralCanvas { flex-shrink:0; border:1px solid var(--border); background:var(--bg); }
.key-info { flex:1; display:flex; flex-direction:column; gap:0.5rem; }
.kf-label { font-family:var(--mono); font-size:0.5rem; letter-spacing:0.18em; color:var(--text-dim); }
.kf-val { font-family:var(--mono); font-size:0.58rem; color:var(--gold); word-break:break-all; line-height:1.4; background:var(--bg); padding:0.28rem 0.5rem; border:1px solid var(--border); border-left:2px solid var(--gold-dim); }
.kf-val.blue { color:var(--blue-bright); border-left-color:var(--blue); }
.kf-val.green { color:var(--green-bright); border-left-color:var(--green); }
.kf-val.purple { color:var(--purple-bright); border-left-color:var(--purple); }

/* PTT */
.ptt-zone { display:flex; flex-direction:column; align-items:center; gap:0.8rem; padding:1.2rem; }
.ptt-outer { position:relative; width:130px; height:130px; display:flex; align-items:center; justify-content:center; }
.ptt-ring { position:absolute; inset:0; border-radius:50%; border:1px solid var(--border); transition:all 0.3s; }
.ptt-ring.active { border-color:var(--gold); box-shadow:0 0 28px rgba(200,160,32,0.2); animation:ring-pulse 0.5s infinite; }
.ptt-ring2 { position:absolute; inset:12px; border-radius:50%; border:1px solid var(--border); opacity:0.4; }
#pttBtn { width:86px; height:86px; border-radius:50%; background:var(--bg2); border:2px solid var(--border); color:var(--text-dim); font-family:var(--mono); font-size:0.52rem; letter-spacing:0.12em; cursor:pointer; transition:all 0.15s; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.25rem; user-select:none; touch-action:none; position:relative; z-index:2; }
#pttBtn:hover { border-color:var(--gold-dim); color:var(--gold); }
#pttBtn.tx { background:radial-gradient(circle,rgba(200,160,32,0.15) 0%,var(--bg2) 70%); border-color:var(--gold); color:var(--gold-glow); box-shadow:0 0 20px rgba(200,160,32,0.3); }
#pttBtn.off { opacity:0.3; cursor:not-allowed; }
.ptt-icon { font-size:1.5rem; line-height:1; }
.ptt-lbl { font-size:0.48rem; letter-spacing:0.15em; }
#waveCanvas { width:100%; height:44px; background:var(--bg); border:1px solid var(--border); display:block; }

/* PEERS LIST */
.peers { display:flex; flex-direction:column; gap:0.4rem; }
.peer-item { display:flex; align-items:center; gap:0.7rem; padding:0.4rem 0.7rem; background:var(--bg); border:1px solid var(--border); font-family:var(--mono); font-size:0.58rem; }
.peer-dot { width:6px; height:6px; border-radius:50%; }
.peer-id { color:var(--blue-bright); flex:1; }
.peer-latency { color:var(--text-dim); }
.peer-key { color:var(--green-bright); font-size:0.5rem; }

/* LOG */
.log { font-family:var(--mono); font-size:0.58rem; color:var(--text-dim); height:110px; overflow-y:auto; line-height:1.85; }
.log::-webkit-scrollbar { width:3px; }
.log::-webkit-scrollbar-thumb { background:var(--border); }
.log-line { padding:0.05rem 0; border-bottom:1px solid rgba(255,255,255,0.015); }
.log-line.gold { color:var(--gold-dim); }
.log-line.blue { color:var(--blue); }
.log-line.green { color:var(--green); }
.log-line.red { color:var(--red-bright); }
.log-line.purple { color:var(--purple); }

/* VPN TAB */
.vpn-steps { display:flex; flex-direction:column; gap:0.7rem; }
.vpn-step { background:var(--bg); border:1px solid var(--border); border-left:2px solid var(--purple); padding:0.8rem 1rem; }
.vpn-step-title { font-family:var(--mono); font-size:0.58rem; color:var(--purple-bright); letter-spacing:0.2em; margin-bottom:0.5rem; }
.vpn-step-body { font-size:0.82rem; color:var(--text-dim); font-style:italic; line-height:1.6; }
.code-block { background:var(--bg); border:1px solid var(--border); padding:0.8rem; font-family:var(--mono); font-size:0.6rem; color:var(--green-bright); line-height:1.8; white-space:pre-wrap; word-break:break-all; margin-top:0.5rem; position:relative; }
.copy-btn { position:absolute; top:0.4rem; right:0.4rem; font-family:var(--mono); font-size:0.5rem; letter-spacing:0.1em; background:var(--border); border:none; color:var(--text-dim); padding:0.2rem 0.5rem; cursor:pointer; }
.copy-btn:hover { color:var(--text); }

.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:0.7rem; }
.stat-box { background:var(--bg); border:1px solid var(--border); padding:0.7rem; text-align:center; }
.stat-val { font-family:var(--mono); font-size:1.1rem; color:var(--gold); }
.stat-lbl { font-family:var(--mono); font-size:0.5rem; color:var(--text-dim); letter-spacing:0.15em; margin-top:0.2rem; }

/* ANIMATIONS */
@keyframes fadeIn { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.5} }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }
@keyframes pulse-gold { 0%,100%{box-shadow:0 0 12px var(--gold-glow)} 50%{box-shadow:0 0 24px var(--gold-glow)} }
@keyframes ring-pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.04);opacity:0.7} }

@media(max-width:520px) {
  .vis-wrap{flex-direction:column}
  .grid2{grid-template-columns:1fr}
  .row{flex-wrap:wrap}
}
</style>
</head>
