// SPIRAL CANVAS
// ═══════════════════════════════════════
const sc = document.getElementById('spiralCanvas');
const sCtx = sc.getContext('2d');
const CX = 79, CY = 79;

function drawSpiral(eng, tx) {
  sCtx.clearRect(0,0,158,158);
  sCtx.fillStyle = '#060708'; sCtx.fillRect(0,0,158,158);

  // Vesica hint circles
  sCtx.strokeStyle = 'rgba(42,122,170,0.15)'; sCtx.lineWidth = 0.5;
  [[CX-19,CY],[CX+19,CY]].forEach(([x,y]) => {
    sCtx.beginPath(); sCtx.arc(x,y,38,0,TAU); sCtx.stroke();
  });

  if (!eng) return;

  // Phi spiral
  sCtx.beginPath();
  let first = true;
  for (let i = 0; i <= 500; i++) {
    const t = (i/500) * 5 * TAU;
    const r = 1.5 * Math.pow(PHI, t/TAU);
    if (r > 72) break;
    const x = CX + r * Math.cos(eng.theta + t);
    const y = CY + r * Math.sin(eng.theta + t);
    if (first) { sCtx.moveTo(x,y); first=false; } else sCtx.lineTo(x,y);
  }
  if (tx) { sCtx.shadowBlur=10; sCtx.shadowColor='#e8c840'; }
  sCtx.strokeStyle = tx ? '#e8c840' : '#c8a020';
  sCtx.lineWidth = tx ? 1.5 : 1;
  sCtx.stroke();
  sCtx.shadowBlur = 0;

  // Current angle marker
  const mr = 24;
  const mx = CX + mr * Math.cos(eng.theta);
  const my = CY + mr * Math.sin(eng.theta);
  sCtx.beginPath(); sCtx.arc(mx,my, tx?4:2.5, 0, TAU);
  sCtx.fillStyle = tx ? '#e8c840' : '#c8a020';
  if (tx) { sCtx.shadowBlur=14; sCtx.shadowColor='#e8c840'; }
  sCtx.fill(); sCtx.shadowBlur=0;

  // Center
  sCtx.beginPath(); sCtx.arc(CX,CY,2,0,TAU);
  sCtx.fillStyle='rgba(200,192,168,0.7)'; sCtx.fill();
}

