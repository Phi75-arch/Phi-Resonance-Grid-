const wc = document.getElementById('waveCanvas');
const wCtx = wc.getContext('2d');
wc.width = wc.offsetWidth || 400; wc.height = 44;
let analyser = null, waveData = new Array(100).fill(0);

function drawWave(active) {
  const W = wc.width, H = wc.height;
  wCtx.fillStyle = '#060708'; wCtx.fillRect(0,0,W,H);
  if (!active) {
    wCtx.strokeStyle='rgba(42,72,60,0.4)'; wCtx.lineWidth=1;
    wCtx.beginPath(); wCtx.moveTo(0,H/2); wCtx.lineTo(W,H/2); wCtx.stroke();
    return;
  }
  if (analyser) {
    const buf = new Uint8Array(analyser.frequencyBinCount);
    analyser.getByteTimeDomainData(buf);
    const step = Math.floor(buf.length/100);
    for (let i=0;i<100;i++) waveData[i] = (buf[i*step]-128)/128;
  } else {
    const t = Date.now()*0.003;
    for (let i=0;i<100;i++) waveData[i] = (Math.random()-0.5)*0.7*Math.sin(t+i*0.28);
  }
  const bw = W/100;
  for (let i=0;i<100;i++) {
    const amp = Math.abs(waveData[i]);
    const bh = amp*(H/2);
    wCtx.fillStyle = `rgba(200,160,32,${0.35+amp*0.65})`;
    wCtx.fillRect(i*bw, H/2-bh, bw-1, bh*2);
  }
}

