async function startTx() {
  if (!connected || transmitting) return;
  transmitting = true;
  const key = engine.advance();
  updateKeyDisplay();

  pttBtn.classList.add('tx');
  pttRing.classList.add('active');
  setStatus('transmitting', `TX · EPOCH ${engine.epoch} · KEY ROTATED`, `${rtc.peers.size} PEER`);
  addLog(`TX begin · epoch ${engine.epoch} · key: ${key}`, 'gold');

  // Real mic via WebRTC stream
  if (rtc && rtc.localStream) {
    const actx = new AudioContext();
    const src = actx.createMediaStreamSource(rtc.localStream);
    analyser = actx.createAnalyser(); analyser.fftSize=256;
    src.connect(analyser);
  } else { analyser = null; }

  let sec = 0;
  txInterval = setInterval(() => { sec++; txSeconds++; $('statTx').textContent=txSeconds+'s'; },1000);
  waveInterval = setInterval(() => drawWave(true), 40);
  clearInterval(spiralInterval);
  spiralInterval = setInterval(() => drawSpiral(engine, true), 40);
}

function stopTx() {
  if (!transmitting) return;
  transmitting = false;
  pttBtn.classList.remove('tx'); pttRing.classList.remove('active');
  setStatus('connected', `LISTENING · CHANNEL OPEN`, `${rtc.peers.size} PEER`);
  addLog(`TX end · ${txSeconds}s total transmitted`, 'blue');
  clearInterval(waveInterval); clearInterval(txInterval);
  drawWave(false); analyser=null;
  clearInterval(spiralInterval);
  spiralInterval = setInterval(() => {
    if (!transmitting && engine) { engine.theta=(engine.theta+0.004)%TAU; drawSpiral(engine,false); }
  }, 50);
}

