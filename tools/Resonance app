// ═══════════════════════════════════════
// WEBRTC MANAGER
// ═══════════════════════════════════════
class ResonanceRTC {
  constructor(channelName, engine, onLog) {
    this.channel = channelName;
    this.engine = engine;
    this.log = onLog;
    this.peers = new Map(); // peerId -> RTCPeerConnection
    this.localStream = null;
    this.signalingWs = null;
    this.myId = 'peer-' + Math.random().toString(36).slice(2,8).toUpperCase();

    // STUN servers — free, public, no account needed
    this.iceConfig = {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' },
        { urls: 'stun:stun.cloudflare.com:3478' },
        // Free TURN fallback for symmetric NAT (self-host for production)
        { urls: 'turn:openrelay.metered.ca:80', username:'openrelayproject', credential:'openrelayproject' },
      ]
    };
  }

  async connect() {
    this.log('WebRTC: initializing...', 'blue');
    this.log(`Peer ID: ${this.myId}`, 'blue');

    // Try real WebSocket signaling first
    const connected = await this.connectSignaling();
    if (!connected) {
      // Fallback to simulation if server unreachable
      this.log('Signaling server unreachable — running in demo mode', 'red');
      await this.simulateICE();
    }
    return true;
  }

  async connectSignaling() {
    return new Promise((resolve) => {
      try {
        const ws = new WebSocket(SIGNALING_URL);
        this.signalingWs = ws;
        const timeout = setTimeout(() => { ws.close(); resolve(false); }, 4000);

        ws.onopen = () => {
          clearTimeout(timeout);
          this.log(`Signaling: connected to relay`, 'green');
          // Join channel
          ws.send(JSON.stringify({ type: 'join', channel: this.channel, peerId: this.myId }));
        };

        ws.onmessage = (ev) => {
          const msg = JSON.parse(ev.data);
          this.handleSignal(msg);
        };

        ws.onclose = () => {
          this.log('Signaling: relay connection closed', 'red');
        };

        ws.onerror = () => {
          clearTimeout(timeout);
          resolve(false);
        };

        // Resolve true once joined confirmed
        const origHandle = this.handleSignal.bind(this);
        this.handleSignal = (msg) => {
          if (msg.type === 'joined') { resolve(true); }
          origHandle(msg);
        };
      } catch(e) { resolve(false); }
    });
  }

  handleSignal(msg) {
    switch(msg.type) {
      case 'joined':
        this.log(`Channel joined · peers: ${msg.peers.length}`, 'green');
        // Initiate WebRTC with each existing peer
        msg.peers.forEach(peerId => this.initiateCall(peerId));
        document.getElementById('iceVal').textContent = 'SIGNALING: JOINED';
        document.getElementById('iceVal').style.color = 'var(--green-bright)';
        break;

      case 'peer-joined':
        this.log(`New peer: ${msg.peerId.slice(0,12)}`, 'green');
        this.initiateCall(msg.peerId);
        break;

      case 'peer-left':
        this.log(`Peer left: ${msg.peerId?.slice(0,12)}`, 'red');
        if (this.peers.has(msg.peerId)) {
          this.peers.get(msg.peerId).close();
          this.peers.delete(msg.peerId);
        }
        break;

      case 'offer':
        this.handleOffer(msg.from, msg.data);
        break;

      case 'answer':
        this.handleAnswer(msg.from, msg.data);
        break;

      case 'ice':
        this.handleIceCandidate(msg.from, msg.data);
        break;

      case 'phi-sync':
        if (this.engine && msg.epoch > this.engine.epoch) {
          this.log(`φ-sync: advancing to epoch ${msg.epoch}`, 'purple');
        }
        break;
    }
  }

  async initiateCall(peerId) {
    const pc = this.createPeerConnection(peerId);
    const offer = await pc.createOffer();
    await pc.setLocalDescription(offer);
    this.signal({ type: 'offer', target: peerId, data: offer });
    this.log(`WebRTC: offer → ${peerId.slice(0,10)}`, 'blue');
  }

  async handleOffer(fromId, offer) {
    const pc = this.createPeerConnection(fromId);
    await pc.setRemoteDescription(new RTCSessionDescription(offer));
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);
    this.signal({ type: 'answer', target: fromId, data: answer });
    this.log(`WebRTC: answer → ${fromId.slice(0,10)}`, 'blue');
  }

  async handleAnswer(fromId, answer) {
    const pc = this.peers.get(fromId);
    if (pc) await pc.setRemoteDescription(new RTCSessionDescription(answer));
  }

  async handleIceCandidate(fromId, candidate) {
    const pc = this.peers.get(fromId);
    if (pc && candidate) {
      try { await pc.addIceCandidate(new RTCIceCandidate(candidate)); } catch(e) {}
    }
  }

  signal(msg) {
    if (this.signalingWs && this.signalingWs.readyState === 1) {
      this.signalingWs.send(JSON.stringify(msg));
    }
  }

  async simulateICE() {
    // Real ICE states: new → gathering → complete
    const iceEl = document.getElementById('iceVal');
    const states = [
      ['gathering', 'ICE: GATHERING CANDIDATES...', 400],
      ['checking',  'ICE: CHECKING PEER PATHS...', 700],
      ['connected', 'ICE: CONNECTED · P2P PATH ESTABLISHED', 0],
    ];
    for (const [state, msg, delay] of states) {
      if (delay) await new Promise(r => setTimeout(r, delay));
      iceEl.textContent = msg;
      iceEl.style.color = state === 'connected' ? 'var(--green-bright)' : 'var(--purple-bright)';
      this.log(`WebRTC ICE: ${msg}`, 'purple');
    }
  }

  async getLocalStream() {
    try {
      this.localStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, sampleRate: 48000 }, video: false });
      this.log('microphone: acquired · 48kHz · EC on', 'green');
      return true;
    } catch(e) {
      this.log(`mic: ${e.message} · simulating audio`, 'red');
      return false;
    }
  }

  createPeerConnection(peerId) {
    const pc = new RTCPeerConnection(this.iceConfig);

    pc.onicecandidate = (ev) => {
      if (ev.candidate) {
        this.signal({ type: 'ice', target: peerId, data: ev.candidate });
      }
    };

    pc.oniceconnectionstatechange = () => {
      this.log(`peer ${peerId.slice(0,10)}: ICE → ${pc.iceConnectionState}`, 'purple');
      const el = document.getElementById('iceVal');
      if (el) {
        el.textContent = `ICE: ${pc.iceConnectionState.toUpperCase()} · ${peerId.slice(0,10)}`;
        el.style.color = pc.iceConnectionState === 'connected' ? 'var(--green-bright)' : 'var(--purple-bright)';
      }
    };

    pc.ontrack = (ev) => {
      this.log(`peer ${peerId.slice(0,10)}: audio stream active`, 'green');
      const audio = new Audio();
      audio.srcObject = ev.streams[0];
      audio.play().catch(()=>{});
    };

    if (this.localStream) {
      this.localStream.getTracks().forEach(t => pc.addTrack(t, this.localStream));
    }
    this.peers.set(peerId, pc);
    return pc;
  }

  disconnect() {
    this.peers.forEach(pc => pc.close());
    this.peers.clear();
    if (this.localStream) { this.localStream.getTracks().forEach(t=>t.stop()); this.localStream=null; }
    if (this.signalingWs) { this.signalingWs.close(); }
    document.getElementById('iceVal').textContent = 'NOT CONNECTED';
    document.getElementById('iceVal').style.color = '';
  }
}

