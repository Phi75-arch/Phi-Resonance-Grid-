class UniversalVisitor:
    # ... (from v12, with optimizations)
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.tree_cache = {}  # For incremental parsing

    def visit_tree(self, node, *args):
        # Parallelize subtrees if large
        if self.config.get('parallel_visitor', False) and len(node.children) > 10:
            with mp.Pool() as pool:
                pool.map(self._visit_parallel, node.children)
        else:
            super().visit_tree(node, *args)

    def _visit_parallel(self, child):
        self.visit_tree(child)  # Note: Shared state needs locks; simplify for now

