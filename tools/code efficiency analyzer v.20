# Constants same as v19

@dataclass(frozen=True)
class Metrics:
    cc: int = 1
    cog: int = 0
    max_nest: int = 0
    operators: int = 0
    unique_operators: int = 0
    operands: int = 0
    unique_operands: int = 0
    vulns: tuple = ()
    secrets: tuple = ()
    smells: tuple = ()
    type_issues: tuple = ()
    loc: int = 0
    duplication: float = 0.0
    unused: tuple = ()
    cves: tuple = ()
    ub_issues: tuple = ()
    fixed_issues: list = field(default_factory=list)
    ai_suggestions: list = field(default_factory=list)  # New: AI code suggestions

class UniversalVisitor:
    # ... (enhanced with JS fixes, AI suggestions)

    def apply_fixes(self, code: str, language: str, dry_run: bool = False, config: Dict = None) -> Tuple[str, List[str]]:
        self.config = config or {}
        fixes = []
        if language == 'python':
            fixed_code, py_fixes = self._fix_python_robust(code)
            fixes.extend(py_fixes)
        elif language == 'rust':
            fixed_code, rs_fixes = self._fix_rust_robust(code)
            fixes.extend(rs_fixes)
        elif language == 'java':
            fixed_code, java_fixes = self._fix_java_robust(code)
            fixes.extend(java_fixes)
        elif language in ['cpp', 'c']:
            fixed_code, cpp_fixes = self._fix_cpp_robust(code)
            fixes.extend(cpp_fixes)
        elif language == 'go':
            fixed_code, go_fixes = self._fix_go_robust(code)
            fixes.extend(go_fixes)
        elif language == 'javascript':  # New: JS autofix
            fixed_code, js_fixes = self._fix_js_robust(code)
            fixes.extend(js_fixes)
        else:
            fixed_code = code

        # AI suggestions (stub: heuristic/random; expand to LLM)
        ai_sugs = self._get_ai_suggestions(fixed_code, language)
        fixes.extend([f'AI Suggestion: {s}' for s in ai_sugs])

        # Prioritize by severity
        severity_order = {'vuln': 0, 'smell': 1, 'unused': 2, 'format': 3}
        fixes = sorted(fixes, key=lambda f: severity_order.get(next((k for k in severity_order if k in f.lower()), 'format'))

        if dry_run:
            diff = '\n'.join(difflib.unified_diff(code.splitlines(), fixed_code.splitlines(), lineterm=''))
            print(f"Dry-run diff for {language}:\n{diff}")
            return code, fixes
        return fixed_code, fixes

    def _get_ai_suggestions(self, code: str, language: str) -> List[str]:
        # Stub AI: Simple heuristics/random suggestions (expand to real LLM via API or local model)
        suggestions = []
        if 'loop' in code.lower():
            suggestions.append('Optimize loop with memoization or vectorization')
        if language == 'javascript' and 'innerHTML' in code:
            suggestions.append('Use DOM manipulation instead of innerHTML for performance')
        # Random example
        suggestions.append(random.choice(['Refactor to async/await', 'Add error handling', 'Use const instead of var']))
        return suggestions

    # _fix_python_robust, etc. same

    def _fix_java_robust(self, code: str) -> Tuple[str, List[str]]:
        fixes = []
        # Format same

        # AST fixes
        try:
            tree = jast.parse(code)

            # Enhanced chaining with validation
            transformers = [
                ImportRemover(self.used_names),
                CatchFixer(),
                SQLiPatcher(),
                XSSPatcher(),
                XXEPatcher(),
                DeserializationPatcher(),
                CSRFPatcher(),
                LoggingPatcher(),
                RCEPatcher(),
            ]
            for trans in transformers:
                if self.config.get(f'enable_{trans.__class__.__name__}', True):
                    try:
                        tree = trans.visit(tree)
                        fixes.extend(trans.fixes)
                        # Validate AST accuracy: Check if unparse-parse matches (simple hash check)
                        reparsed = jast.parse(jast.unparse(tree))
                        if hash(jast.unparse(reparsed)) != hash(jast.unparse(tree)):
                            fixes.append(f'Warning: Transformer {trans.__class__.__name__} may have accuracy issues')
                    except Exception as e:
                        fixes.append(f'{trans.__class__.__name__} error: {e}')

            fixed_code = jast.unparse(tree)
        except Exception as e:
            fixed_code = code
            fixes.append(f'jAST global error: {e}')

        return fixed_code, fixes

    def _fix_js_robust(self, code: str) -> Tuple[str, List[str]]:
        fixes = []
        # Format with prettier (assume installed globally)
        try:
            subprocess.run(['prettier', '--write', self.path], check=True)
            fixes.append('Applied prettier formatting (format)')
        except Exception as e:
            fixes.append(f'prettier error: {e}')

        # Use tree-sitter-javascript for AST fixes
        try:
            if 'javascript' not in TS_LANGUAGES:
                raise ValueError('JS parser not loaded')
            parser = Parser()
            parser.set_language(TS_LANGUAGES['javascript'])
            tree = parser.parse(bytes(code, 'utf8'))

            # Text-based patches for vulns (since tree-sitter not full transformer; expand with esprima/escodegen if needed)
            # XSS: Replace innerHTML
            fixed_code = re.sub(r'\.innerHTML\s*=\s*', '.textContent = // FIXED: XSS prevention ', code)
            fixes.append('Patched innerHTML to textContent (vuln XSS)')

            # CSRF: Add token stub
            if 'fetch' in code or 'XMLHttpRequest' in code:
                fixed_code = fixed_code.replace('fetch(', 'fetch( // FIXED: Add CSRF token header')
                fixes.append('Added CSRF token stub (vuln CSRF)')

            # Prototype Pollution: Add Object.freeze
            if '__proto__' in code:
                fixed_code += '\n// FIXED: Object.freeze(Object.prototype); // Prevent pollution'
                fixes.append('Added prototype freeze (vuln Prototype Pollution)')

            # Insecure Deserialization: Suggest validation
            if 'JSON.parse' in code:
                fixed_code = re.sub(r'JSON\.parse\(', 'validateAndParse( // FIXED: Add validation before parse ', fixed_code)
                fixes.append('Added deserialization validation stub (vuln Insecure Deserialization)')

            # SQLi (if Node.js): Suggest prepared
            if 'query' in code and 'sql' in code.lower():
                fixed_code += '\n// FIXED: Use parameterized queries or ORM like Sequelize'
                fixes.append('Suggested parameterized queries (vuln SQLi)')

            # Remove unused: Use eslint --fix (assume installed)
            try:
                subprocess.run(['eslint', '--fix', self.path], check=True)
                fixes.append('Applied eslint fixes (unused, smells)')
            except:
                pass

            # Reload if changed
            with open(self.path, 'r') as f:
                fixed_code = f.read()

        except Exception as e:
            fixed_code = code
            fixes.append(f'JS fix error: {e}')

        return fixed_code, fixes

