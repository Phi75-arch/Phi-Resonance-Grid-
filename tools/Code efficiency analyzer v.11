# Rest of the classes (Halstead, Bench, Analyzer) adapted

class Analyzer:
    def __init__(self, path: str, func_name='main', scales=None, config_file=None, use_cache=True):
        self.path = path
        # ... (from v10)
        self.language = LANGUAGE_PARSERS.get(os.path.splitext(path)[1], 'python')

    def static_analysis(self, detailed=False, with_halstead=False) -> Dict:
        # ... (from v10)
        with open(self.path, 'r') as f:
            code = f.read()
            self.code_lines = code.splitlines()

        if self.language == 'python':
            tree = ast.parse(code)
        else:
            if self.language not in TS_LANGUAGES:
                return {'error': f'Unsupported language: {self.language}'}
            parser = Parser()
            parser.set_language(TS_LANGUAGES[self.language])
            tree = parser.parse(bytes(code, 'utf8'))

        visitor = UniversalVisitor(detailed=detailed, config=self.config, code_lines=self.code_lines, language=self.language)
        visitor.visit_tree(tree)
        m = visitor.get_result()
