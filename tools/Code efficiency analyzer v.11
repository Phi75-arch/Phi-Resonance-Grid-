sys.setrecursionlimit(5000)

# Expanded Constants
VULN_FUNCS = frozenset({'exec', 'eval', '__import__', 'compile', 'open', 'input'})
VULN_ATTRS = frozenset({'system', 'popen', 'spawn', 'call', 'Popen', 'run', 'check_output', 'load', 'loads'})
DANGEROUS = frozenset({'os', 'subprocess', 'shlex', 'commands', 'pickle', 'yaml', 'json', 'requests'})

SECRETS_PATTERNS = [
    re.compile(r'(?i)api_key\s*=\s*["\']([a-zA-Z0-9_\-]{20,})["\']'),
    re.compile(r'(?i)password\s*=\s*["\'](.+?)["\']'),
    re.compile(r'(?i)secret\s*=\s*["\']([a-zA-Z0-9_\-]{32,})["\']'),
]

# Language-specific configs (extendable)
LANGUAGE_PARSERS = {
    '.py': 'python',
    '.js': 'javascript',
    '.java': 'java',
    '.cpp': 'cpp',
    # Add more: Download tree-sitter-<lang> and build Language
}

# Load tree-sitter languages (assume user has installed)
TS_LANGUAGES = {}
for lang in set(LANGUAGE_PARSERS.values()):
    try:
        TS_LANGUAGES[lang] = Language(f'build/my-languages.so', lang)  # User must build shared lib
    except:
        print(f"Warning: Tree-sitter language {lang} not loaded.", file=sys.stderr)

COG_WEIGHTS = {  # Generalized for multi-lang (node types approximated)
    'If': 1, 'For': 1, 'While': 1, 'Try': 1, 'With': 1,
    'Assert': 1, 'Lambda': 1, 'comprehension': 1, 'IfExp': 1,
    'BoolOp': 0,
}

HALSTEAD_OPERATORS = frozenset({
    'if', 'else', 'elif', 'for', 'while', 'try', 'except', 'finally', 'with', 'assert',
    'def', 'class', 'return', 'yield', 'raise', 'break', 'continue', 'pass',
    '+', '-', '*', '/', '%', '**', '//', '==', '!=', '<', '>', '<=', '>=',
    'and', 'or', 'not', 'in', 'is', '&', '|', '^', '~', '<<', '>>',
    '=', '+=', '-=', '*=', '/=', '%=', '**=', '//=',
})

@dataclass(frozen=True)
class Metrics:
    cc: int = 1
    cog: int = 0
    max_nest: int = 0
    operators: int = 0
    unique_operators: int = 0
    operands: int = 0
    unique_operands: int = 0
    vulns: tuple = ()
    secrets: tuple = ()
    smells: tuple = ()
    type_issues: tuple = ()
    loc: int = 0
    duplication: float = 0.0
    unused: tuple = ()

class UniversalVisitor:
    __slots__ = (
        'cc', 'cog', 'nest', 'cur_nest',
        'ops_count', 'ops_unique',
        'opnds_count', 'opnds_unique',
        'vulns', 'secrets', 'smells', 'types',
        'loc', 'in_func', 'func_loc', 'param_count',
        'detailed_cc', 'lines', 'dupe_sequences',
        'unused_vars', 'used_names', 'defined_names',
        'config', 'code_lines', 'language'
    )

    def __init__(self, detailed=False, config: Dict = None, code_lines: List[str] = None, language: str = 'python'):
        self.cc = 1
        self.cog = 0
        self.nest = 0
        self.cur_nest = 0
        self.ops_count = 0
        self.ops_unique = set()
        self.opnds_count = 0
        self.opnds_unique = set()
        self.vulns = set()
        self.secrets = set()
        self.smells = set()
        self.types = set()
        self.loc = len(code_lines)
        self.in_func = False
        self.func_loc = 0
        self.param_count = 0
        self.detailed_cc = defaultdict(int) if detailed else None
        self.lines = defaultdict(list) if detailed else None
        self.dupe_sequences = []
        self.unused_vars = set()
        self.used_names = set()
        self.defined_names = set()
        self.config = config or {}
        self.code_lines = code_lines or []
        self.language = language

    def visit_tree(self, node, line=1):
        # Generalized visit for tree-sitter or ast nodes
        if self.language == 'python' and isinstance(node, ast.AST):
            self._visit_ast(node)
        else:
            self._visit_ts(node, line)

    def _visit_ast(self, node):
        # Existing Python AST visitor logic (from v10)
        node_type = type(node).__name__
        # ... (copy from v10 FastVisitor.visit, adapt as needed)
        # For brevity, assume similar logic

    def _visit_ts(self, node, line):
        node_type = node.type
        # Generalize metrics for other langs
        if node_type in ('if_statement', 'for_statement', 'while_statement', 'try_statement'):
            self.cc += 1
            self.cog += 1 + self.cur_nest
            self.cur_nest += 1
            self.nest = max(self.nest, self.cur_nest)

        # Halstead approximation
        if node_type in HALSTEAD_OPERATORS:
            self.ops_unique.add(node_type)
            self.ops_count += 1

        # Recurse children
        for child in node.children:
            self.visit_tree(child, line + 1)  # Approximate line

        # Backtrack nesting
        if node_type in ('if_statement', 'for_statement', 'while_statement', 'try_statement'):
            self.cur_nest -= 1

        # Vulns/secrets (text-based for non-Python)
        if 'call' in node_type or 'function_call' in node_type:
            # Approximate vuln check via text
            text = node.text.decode('utf-8') if hasattr(node, 'text') else ''
            if any(f in text for f in VULN_FUNCS):
                self.vulns.add(text[:50])

        # Secrets via regex on code_lines

