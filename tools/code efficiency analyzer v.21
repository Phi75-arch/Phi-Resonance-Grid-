# ─── AI Suggestion Engine (expanded) ─────────────────────────────────────────

class AISuggestionEngine:
    def __init__(self, config: Dict = None):
        self.config = config or {}
        self.depth = self.config.get('ai_depth', 'medium')  # light / medium / heavy

    def suggest(self, code: str, language: str, metrics: Dict) -> List[str]:
        sugs = []

        # Common rules (light)
        if metrics.get('cc', 1) > 15:
            sugs.append("High cyclomatic complexity → extract methods or use strategy pattern")
        if metrics.get('cog', 0) > 20:
            sugs.append("Cognitive complexity very high → simplify conditionals, extract predicates")

        # Language-specific
        if language in ('javascript', 'typescript'):
            if 'innerHTML' in code:
                sugs.append("Security + perf: Replace .innerHTML with .textContent + DOMPurify or lit-html")
            if 'var ' in code:
                sugs.append("Modernize: Replace var → const / let")
            if 'Promise.then' in code and 'async' not in code:
                sugs.append("Convert Promise chains to async/await for readability")

        # Medium / heavy depth heuristics
        if self.depth in ('medium', 'heavy'):
            if 'loop' in code.lower() and 'forEach' in code:
                sugs.append("Performance: Consider for-of or traditional for loop instead of forEach in hot paths")
            if language == 'typescript' and 'any' in code:
                sugs.append("Type safety: Replace any with unknown or proper union/interface")

        # Simulated "LLM-style" creative suggestions (heavy only)
        if self.depth == 'heavy':
            sugs.extend([
                "Consider functional paradigm shift: use pure functions + immutability",
                "Profile first: add console.time() around suspected bottlenecks",
                random.choice([
                    "Adopt design pattern: Observer / Pub-Sub for event handling",
                    "Micro-optimize: Use object literal cache instead of Map in hot loops",
                    "Add unit tests around complex logic using Jest / Vitest"
                ])
            ])

        return list(dict.fromkeys(sugs))  # dedup


# ─── JS/TS Robust Fixes ──────────────────────────────────────────────────────

def _fix_js_ts_robust(self, code: str, language: str) -> Tuple[str, List[str]]:
    fixes = []
    is_ts = language == 'typescript'

    # 1. Formatting
    try:
        cmd = ['prettier', '--write', self.path] if not is_ts else ['prettier', '--parser', 'typescript', '--write', self.path]
        subprocess.run(cmd, check=True)
        fixes.append(f'Applied prettier ({language} formatting)')
    except Exception as e:
        fixes.append(f'prettier failed: {e}')

    # 2. ESLint + fix (TS-aware)
    try:
        eslint_cmd = ['eslint', '--fix', self.path]
        if is_ts:
            eslint_cmd += ['--ext', '.ts,.tsx']
        subprocess.run(eslint_cmd, check=True)
        fixes.append(f'Applied ESLint --fix ({language} lint + auto-fix)')
    except Exception as e:
        fixes.append(f'ESLint failed: {e}')

    # 3. Tree-sitter AST-based robust patches
    try:
        parser = Parser()
        parser.set_language(TS_LANGUAGES[language])
        tree = parser.parse(bytes(code, 'utf8'))

        # Robust vuln patching (text + node traversal)
        root = tree.root_node
        changes = []

        def traverse(node):
            if node.type == 'jsx_opening_element' and any(c.type == 'jsx_attribute' and 'dangerouslySetInnerHTML' in c.text.decode() for c in node.children):
                changes.append((node.start_byte, node.end_byte, b'/* FIXED: XSS - use children prop instead of dangerouslySetInnerHTML */'))
            if node.type == 'call_expression' and 'innerHTML' in node.text.decode():
                changes.append((node.start_byte, node.end_byte, b'.textContent /* FIXED: XSS prevention */'))
            if node.type == 'call_expression' and 'eval' in node.text.decode():
                changes.append((node.start_byte, node.end_byte, b'/* FIXED: eval() removed - use Function constructor only if absolutely necessary */'))
            for child in node.children:
                traverse(child)

        traverse(root)

        # Apply changes in reverse order to preserve positions
        fixed_bytes = bytearray(code.encode('utf8'))
        for start, end, repl in sorted(changes, key=lambda x: x[0], reverse=True):
            fixed_bytes[start:end] = repl

        fixed_code = fixed_bytes.decode('utf8', errors='replace')
        fixes.extend([f'Patched {len(changes)} potential issues via tree-sitter'] if changes else [])

    except Exception as e:
        fixed_code = code
        fixes.append(f'tree-sitter JS/TS patch error: {e}')

    return fixed_code, fixes


# ─── Integrate into Analyzer ─────────────────────────────────────────────────

class Analyzer:
