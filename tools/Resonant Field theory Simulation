def animate(frame):
    """Animation update function"""
    global pos, s, C_history, Φ_history, event_scheduled
   
    # Trigger external event mid-simulation
    if frame == event_time and not event_scheduled:
        magnitude = 0.7 if event_type == 'inspiration' else -0.6
        apply_external_event(event_node, magnitude)
        event_scheduled = True
   
    # Run simulation step
