C_t = 0.0              # Consensus field coherence
C_history = []         # Historical trajectory
Φ = 1.0               # Grid field strength
Φ_history = []        # Historical trajectory

# Communication network (small-world topology)
communication_network = nx.watts_strogatz_graph(
    N_NODES,
    k=int(PHI * 3),    # Average degree ≈ 5 (Fibonacci)
