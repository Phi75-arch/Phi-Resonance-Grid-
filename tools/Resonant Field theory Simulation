Avg Intention: {np.mean(I):.3f}
Phase Std:     {np.std(θ):.3f}

Group Coherence:
"""
   
    for i, group in enumerate(group_nodes[:3]):
        metrics_str += f"  G{i}: {group.coherence():.3f}\n"
   
    metrics_text.set_text(metrics_str)
   
    return scatter, line_c, line_phi, *pop_bars, metrics_text

