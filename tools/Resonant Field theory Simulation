class GroupNode:
    """
    Emergent group consciousness at different scales.
    Groups are real resonant structures, not mere aggregates.
    """
    def __init__(self, member_indices, level=0):
        self.members = member_indices
        self.level = level  # 0=individual, 1=community, 2=nation
       
    def collective_s(self):
        """Average service orientation"""
        return np.mean(s[self.members])
   
    def collective_I(self):
        """Average intention coherence"""
        return np.mean(I[self.members])
   
    def collective_theta(self):
        """Circular mean of intentional phase"""
        sins = np.sin(θ[self.members])
        coss = np.cos(θ[self.members])
        return np.arctan2(np.mean(sins), np.mean(coss))
   
    def coherence(self):
        """
        How aligned are group members?
        High coherence = strong collective consciousness
        """
        return self.collective_I() * np.abs(np.cos(np.std(θ[self.members])))

def create_hierarchies():
    """Create community-level group nodes"""
    groups = []
    cluster_size = 8  # Fibonacci number
    for i in range(0, N_NODES, cluster_size):
        members = list(range(i, min(i + cluster_size, N_NODES)))
        groups.append(GroupNode(members, level=1))
    return groups

group_nodes = create_hierarchies()

# ====================
# Γ OPERATOR: RESONANCE DYNAMICS
# ====================

def calculate_interaction(node_i, node_j, pos_i, pos_j):
    """
    Postulate 1: Sympathetic Coupling
   
    Interaction strength proportional to:
    - Intention coherence (both must be clear)
    - Phase alignment (shared purpose)
    - Service coefficient product (STO-STO cooperate, STO-STS friction)
    - Spatial proximity
    - Network connectivity
    """
   
    # Spatial distance decay
    dist = np.linalg.norm(pos_i - pos_j)
    if dist == 0:
        return 0.0
   
    if dist > INTERACTION_RADIUS * 1.5:
        spatial_coupling = 0.0
    else:
        spatial_coupling = 1.0 / (dist**0.5)
   
    # Network topology bonus (Extension 4)
    network_coupling = 2.0 if communication_network.has_edge(node_i, node_j) else 1.0
   
    # Phase alignment: cos(θᵢ - θⱼ)
    phase_alignment = np.cos(θ[node_i] - θ[node_j])
   
    # Resource modulation
    # Scarcity reduces cooperation potential
    resource_factor = (resource_field[node_i] + resource_field[node_j]) / 2
   
    # Core interaction formula (Postulate 1)
    interaction = (
        I[node_i] * I[node_j] *           # Both must have coherent intention
        phase_alignment *                  # Aligned purpose
        s[node_i] * s[node_j] *           # Service orientation product
        spatial_coupling *                 # Distance matters
        network_coupling *                 # Communication channels
        (0.5 + 0.5 * resource_factor)     # Scarcity penalty
    )
   
    return COUPLING_STRENGTH * interaction

def update_node_states():
    """
    Update all node states based on resonant interactions.
    Implements the core dynamics of the Γ operator.
    """
    global s, I, θ, pos, C_t, Φ, resource_field, satisfaction_history
   
    new_s = np.copy(s)
    new_I = np.copy(I)
    new_θ = np.copy(θ)
    force_vectors = np.zeros((N_NODES, 2))
   
    # Calculate experienced reality quality for each node
    experienced_quality = np.zeros(N_NODES)
   
    for i in range(N_NODES):
        total_interaction = 0.0
       
        for j in range(N_NODES):
            if i == j:
                continue
           
            interaction = calculate_interaction(i, j, pos[i], pos[j])
            total_interaction += interaction
           
            # State evolution through resonance
            new_s[i] += interaction * 0.1
           
            # Phase dynamics: nodes with positive interaction align phases
            phase_diff = θ[j] - θ[i]
            new_θ[i] += interaction * 0.05 * np.sin(phase_diff)
           
            # Intention coherence grows through positive interaction
            if interaction > 0:
                new_I[i] += interaction * 0.02
           
            # Physical movement: attracted to resonant nodes
            if s[i]*s[j] > 0 and np.cos(θ[i]-θ[j]) > 0:
                direction = pos[j] - pos[i]
                dist = np.linalg.norm(direction)
                if dist > 0:
                    force_vectors[i] += (direction / dist) * abs(interaction) * 0.5
       
        # Experienced reality quality (for learning)
        # Combines global field with local interactions
        experienced_quality[i] = C_t * Φ + total_interaction * 0.1
   
    # Learning from experience (Extension 5)
    learn_from_experience(experienced_quality)
   
    # Resource dynamics (Extension 2)
    update_resources()
   
    # Apply state updates with bounds
    s = np.clip(new_s, -1.0, 1.0)
    I = np.clip(new_I, 0.0, 1.0)
    θ = new_θ % (2*np.pi)
   
    # Update positions
    pos += force_vectors
    pos = np.clip(pos, 0, 10)

def learn_from_experience(experienced_quality):
    """
    Postulate 5 Extension: Temporal Learning
   
    Nodes adjust their strategy based on satisfaction.
    This creates evolutionary pressure toward STO.
    """
    global s, θ, I, satisfaction_history
   
    # Update satisfaction history (rolling window)
    satisfaction_history = np.roll(satisfaction_history, 1, axis=1)
    satisfaction_history[:, 0] = experienced_quality
   
    # Calculate recent satisfaction trend
    recent_satisfaction = np.mean(satisfaction_history, axis=1)
    satisfaction_trend = experienced_quality - recent_satisfaction
   
    for i in range(N_NODES):
        if satisfaction_trend[i] > 0.1:
            # Positive trend: reinforce current strategy
            I[i] *= (1 + LEARNING_RATE)
            I[i] = min(I[i], 1.0)
           
        elif satisfaction_trend[i] < -0.1:
            # Negative trend: explore alternatives
           
            # Small random walk in phase
            θ[i] += np.random.normal(0, 0.2)
           
            # Occasionally flip service orientation if deeply dissatisfied
            if recent_satisfaction[i] < -0.5 and np.random.random() < 0.05:
                # "Conversion experience"
                s[i] *= -0.5  # Soften and reverse
                θ[i] += np.pi  # Phase shift

def update_resources(target_node=None, event_magnitude=0.0):
    """
    Extension 2: Resource Field Dynamics
   
    STO cooperation creates abundance.
    STS extraction depletes resources.
    Scarcity pushes toward survival mode (STS).
    """
    global resource_field, s
   
    # STO nodes share resources with neighbors
    for i in range(N_NODES):
        if s[i] > 0:
            neighbors = np.where(
                np.linalg.norm(pos - pos[i], axis=1) < INTERACTION_RADIUS
            )[0]
           
            for neighbor in neighbors:
                if neighbor != i:
                    resource_field[neighbor] += s[i] * I[i] * 0.01
   
    # STS extraction depletes resources
    sts_nodes = np.where(s < -0.2)[0]
    for i in sts_nodes:
        resource_field[i] -= abs(s[i]) * 0.02
   
    # Scarcity pressure pushes toward STS (survival mode)
    scarcity_pressure = (1 - resource_field) * 0.03
    s_change = -scarcity_pressure * (s > 0)  # Only affects STO nodes
   
    s += s_change
   
    # Apply external event if triggered
    if target_node is not None:
        apply_external_event(target_node, event_magnitude)
   
    # Bounds and slow regeneration
    resource_field = np.clip(resource_field, 0.1, 1.5)
    resource_field += 0.005  # Nature's slow abundance

def apply_external_event(target_node, magnitude):
    """
    Extension 1: External Forcing Functions
   
    Simulates crises (negative) or inspiration (positive).
    Same event produces different outcomes based on pre-existing coherence.
    """
    global s, I, θ, resource_field
   
    if magnitude > 0:  # Positive event (inspiration, abundance)
        influence_radius = INTERACTION_RADIUS * magnitude
        distances = np.linalg.norm(pos - pos[target_node], axis=1)
        influenced = distances < influence_radius
       
        # Inspiration: clarifies intention, shifts toward STO
        I[influenced] += magnitude * 0.2
        s[influenced] += magnitude * 0.3 * (1 - s[influenced])  # Asymptotic to 1
       
        # Resource abundance
        resource_field[influenced] += magnitude * 0.5
       
    elif magnitude < 0:  # Negative event (crisis, scarcity)
        magnitude = abs(magnitude)
        influence_radius = INTERACTION_RADIUS * magnitude
        distances = np.linalg.norm(pos - pos[target_node], axis=1)
        influenced = distances < influence_radius
       
        # Crisis: clarifies intention but tests service orientation
        I[influenced] += magnitude * 0.15
       
        # Low-coherence nodes may flip to STS (survival mode)
        low_intention = I[influenced] < 0.3
        influenced_indices = np.where(influenced)[0]
        low_intention_indices = influenced_indices[low_intention[:len(influenced_indices)]]
        s[low_intention_indices] -= magnitude * 0.4
       
        # Resource scarcity
        resource_field[influenced] *= (1 - magnitude * 0.5)
        resource_field[influenced] = np.maximum(resource_field[influenced], 0.1)

def update_global_field():
    """
    Postulates 2 & 5: Non-Linear Amplification and Hysteresis
   
    Updates consensus field C(t) and grid field Φ.
    Includes phase transition dynamics and memory.
    """
    global C_t, Φ, C_history, Φ_history
   
    # Individual contributions
    sto_strength = np.mean(np.where(s > 0, s * I, 0))
    sts_strength = np.mean(np.where(s < 0, -s * I, 0))
   
    # Group coherence bonus (Extension 3)
    group_coherence_bonus = 0.0
    for group in group_nodes:
        group_coherence_bonus += group.coherence() * len(group.members) / N_NODES
   
    net_coherence = sto_strength - sts_strength + group_coherence_bonus * 0.1
   
    # Postulate 2: Non-linear sigmoid with PHI-scaled threshold
    sigmoid_input = net_coherence * N_NODES * 0.1 - CRITICAL_THRESHOLD
    delta_C = 1 / (1 + np.exp(-sigmoid_input)) - 0.5
   
    # Postulate 5: Hysteresis (memory/feedback)
    C_t = HYSTERESIS * C_t + (1 - HYSTERESIS) * delta_C * 2
    C_history.append(C_t)
   
    # Postulate 3: Grid coherence modulated by consensus
    Φ = np.clip(1.0 + GRID_INFLUENCE * C_t, 0.5, 1.5)
    Φ_history.append(Φ)

