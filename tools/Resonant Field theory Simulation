    ax_resource.hist(resource_field, bins=20, color='green', alpha=0.6)
    ax_resource.set_xlim(0, 1.5)
    ax_resource.set_xlabel('Resource Level')
    ax_resource.set_ylabel('Node Count')
    ax_resource.set_title('Resource Distribution', fontweight='bold')
