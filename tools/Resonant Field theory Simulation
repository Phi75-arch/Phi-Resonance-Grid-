    update_global_field()
   
    # Update spatial view
    scatter.set_offsets(pos)
    scatter.set_array(s)
    scatter.set_sizes(I * 200)
   
    # Update C(t) plot
    line_c.set_data(range(len(C_history)), C_history)
   
    # Update Φ(t) plot
    line_phi.set_data(range(len(Φ_history)), Φ_history)
   
    # Update population bars
    sto_pct = np.sum(s > 0.1) / N_NODES * 100
    sts_pct = np.sum(s < -0.1) / N_NODES * 100
    neutral_pct = 100 - sto_pct - sts_pct
   
    for bar, height in zip(pop_bars, [sts_pct, neutral_pct, sto_pct]):
        bar.set_height(height)
   
